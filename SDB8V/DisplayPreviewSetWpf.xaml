<Window x:Class="SymbolDB.DisplayPreviewSetWpf"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Display Preview Set" Width="1200" Height="800" WindowState="Maximized"
        Background="#20232B" Foreground="White" PreviewKeyDown="Window_PreviewKeyDown"
        Closed="Window_Closed">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3A4050" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="3" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="8">
            <TextBlock x:Name="PageStatus" VerticalAlignment="Center" FontSize="16" DockPanel.Dock="Left" Margin="8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <TextBlock Text="Rows: 1–8 (3 default)" VerticalAlignment="Center" Margin="10,0" />
                <Button Content="First" Click="First_Click" />
                <Button Content="Previous Page" Click="Previous_Click" />
                <Button Content="Next Page" Click="Next_Click" />
                <Button Content="Last" Click="Last_Click" />
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1" x:Name="PreviewSurface" Background="#2C303B" SizeChanged="PreviewSurface_SizeChanged">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <UniformGrid x:Name="ImageGrid" Rows="3" Columns="1" Margin="8" />
            </ScrollViewer>
            <Border x:Name="LoadingOverlay" Visibility="Collapsed" Background="#CC14161C"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32,20" CornerRadius="8" Panel.ZIndex="10">
                <TextBlock Text="loading images, please wait ..." FontSize="22" Foreground="White" />
            </Border>
        </Grid>
        <TextBlock Grid.Row="2" x:Name="Hint" Margin="12,6" Foreground="#BAC3D5"
                   Text="←/→: one image   ↑/↓: one row   PgUp/PgDn: one page   Home/End: first/last   1–8: rows   F: filenames   R/T: auto-page   Esc: close" />
    </Grid>
</Window>
