<Window x:Class="SymbolDB.AnnotationBrowserWpf"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deck Annotations"
        Width="1300"
        Height="820"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#171820"
        Foreground="#E8E8EC"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#23242D" />
        <SolidColorBrush x:Key="BorderBrush" Color="#3A3D49" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A5A7B2" />

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#ECECF1" />
            <Setter Property="Background" Value="#343642" />
            <Setter Property="BorderBrush" Value="#4A4D5A" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="3" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#20212A"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal">
                    <Button Content="Previous"
                            Click="Previous_Click" />
                    <Button Content="Next"
                            Click="Next_Click" />
                </StackPanel>

                <StackPanel>
                    <TextBlock x:Name="DeckNameTextBlock"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="DeckFolderTextBlock"
                               Foreground="{StaticResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- All annotations -->
            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="AnnotationCountTextBlock"
                               Margin="6"
                               FontSize="15"
                               FontWeight="SemiBold" />

                    <ListBox x:Name="AnnotationListBox"
                             Grid.Row="1"
                             Background="#1C1D25"
                             Foreground="White"
                             BorderThickness="0"
                             SelectionChanged="AnnotationListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="84"
                                            Height="84"
                                            Background="#111219"
                                            BorderBrush="#454854"
                                            BorderThickness="1">
                                        <Image Source="{Binding Thumbnail}"
                                               Stretch="Uniform" />
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                Margin="9,0,0,0">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding CardText}"
                                                   Margin="0,4,0,0"
                                                   Foreground="#83B8FA" />
                                        <TextBlock Text="{Binding ImageName}"
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          Background="#30323C" />

            <!-- Related source image and annotation details -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Background="#0F1016"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">
                    <Grid x:Name="PreviewHost"
                          SizeChanged="PreviewHost_SizeChanged">
                        <Image x:Name="RelatedImage"
                               Stretch="Uniform" />

                        <Canvas x:Name="AnnotationOverlay"
                                IsHitTestVisible="False" />

                        <TextBlock x:Name="MissingImageTextBlock"
                                   Visibility="Collapsed"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#FF8C8C"
                                   FontSize="18"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="20" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
              Margin="0,8,0,0"
              MaxHeight="280"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled">
    <Border Padding="12"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Margin="0,0,16,8"
                       Text="Title"
                       Foreground="{StaticResource MutedBrush}" />

            <TextBlock x:Name="TitleTextBlock"
                       Grid.Row="0"
                       Grid.Column="1"
                       Margin="0,0,0,8"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Margin="0,0,16,8"
                       Text="Comment"
                       Foreground="{StaticResource MutedBrush}" />

            <TextBlock x:Name="CommentTextBlock"
                       Grid.Row="1"
                       Grid.Column="1"
                       Margin="0,0,0,8"
                       TextWrapping="Wrap" />

            <TextBlock Grid.Row="2"
                       Grid.Column="0"
                       Margin="0,0,16,8"
                       Text="Keywords"
                       Foreground="{StaticResource MutedBrush}" />

            <TextBlock x:Name="KeywordsTextBlock"
                       Grid.Row="2"
                       Grid.Column="1"
                       Margin="0,0,0,8"
                       Foreground="#83B8FA"
                       TextWrapping="Wrap" />

            <TextBlock Grid.Row="3"
                       Grid.Column="0"
                       Margin="0,0,16,8"
                       Text="Cross-references"
                       Foreground="{StaticResource MutedBrush}" />

            <TextBlock x:Name="ReferencesTextBlock"
                       Grid.Row="3"
                       Grid.Column="1"
                       Margin="0,0,0,8"
                       TextWrapping="Wrap" />

            <TextBlock Grid.Row="4"
                       Grid.Column="0"
                       Margin="0,0,16,0"
                       Text="Image"
                       Foreground="{StaticResource MutedBrush}" />

            <TextBlock x:Name="ImagePathTextBlock"
                       Grid.Row="4"
                       Grid.Column="1"
                       TextWrapping="Wrap" />
        </Grid>
    </Border>
</ScrollViewer>
            </Grid>
        </Grid>

        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="2"
                   Margin="10,4"
                   Foreground="{StaticResource MutedBrush}" />
    </Grid>
</Window>