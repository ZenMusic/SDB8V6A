<Window x:Class="SymbolDB.AnnotationDisplayWpf"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Annotation Display"
        Width="1500"
        Height="900"
        MinWidth="1050"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="#171820"
        Foreground="#E8E8EC"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#23242D" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#2B2D38" />
        <SolidColorBrush x:Key="BorderBrush" Color="#3A3D49" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A5A7B2" />
        <SolidColorBrush x:Key="AccentBrush" Color="#4E91E8" />

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#ECECF1" />
            <Setter Property="Background" Value="#343642" />
            <Setter Property="BorderBrush" Value="#4A4D5A" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="DetailLabelStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="0,0,14,10" />
        </Style>

        <Style x:Key="DetailValueStyle"
               TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0"
                Background="#20212A"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="DeckNameTextBlock"
                               FontSize="18"
                               FontWeight="SemiBold" />

                    <TextBlock x:Name="DeckFolderTextBlock"
                               Foreground="{StaticResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="PreviousCardButton"
                            Content="Previous Card"
                            Click="PreviousCard_Click" />

                    <Button x:Name="NextCardButton"
                            Content="Next Card"
                            Click="NextCard_Click" />

                    <Separator Margin="8,2" />

                    <Button x:Name="PreviousAnnotationButton"
                            Content="Previous Annotation"
                            Click="PreviousAnnotation_Click" />

                    <Button x:Name="NextAnnotationButton"
                            Content="Next Annotation"
                            Click="NextAnnotation_Click" />

                    <TextBlock Text="Overlays:"
                               Margin="14,0,6,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" />

                    <ComboBox x:Name="OverlayModeComboBox"
                              Width="125"
                              SelectedIndex="0"
                              VerticalAlignment="Center"
                              SelectionChanged="OverlayModeComboBox_SelectionChanged">
                        <ComboBoxItem Content="All" Tag="All" />
                        <ComboBoxItem Content="Selected only"
                                      Tag="SelectedOnly" />
                        <ComboBoxItem Content="Hidden" Tag="Hidden" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main three-column layout -->
        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"
                                  MinWidth="240"
                                  MaxWidth="520" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="350" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="380"
                                  MinWidth="280"
                                  MaxWidth="600" />
            </Grid.ColumnDefinitions>

            <!-- Spatially sorted annotation list -->
            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="6">
                        <TextBlock x:Name="AnnotationCountTextBlock"
                                   FontSize="15"
                                   FontWeight="SemiBold" />

                        <TextBlock x:Name="CardPositionTextBlock"
                                   DockPanel.Dock="Right"
                                   HorizontalAlignment="Right"
                                   Foreground="{StaticResource MutedBrush}" />
                    </DockPanel>

                    <ListBox x:Name="AnnotationListBox"
                             Grid.Row="1"
                             Background="#1C1D25"
                             Foreground="White"
                             BorderThickness="0"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             SelectionChanged="AnnotationListBox_SelectionChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="26"
                                            Height="26"
                                            Margin="0,4,6,0"
                                            VerticalAlignment="Top"
                                            CornerRadius="13"
                                            Background="{StaticResource AccentBrush}">
                                        <TextBlock Text="{Binding Sequence}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold"
                                                   Foreground="White" />
                                    </Border>

                                    <Border Grid.Column="1"
                                            Width="70"
                                            Height="82"
                                            Background="#111219"
                                            BorderBrush="#454854"
                                            BorderThickness="1">
                                        <Image Source="{Binding Thumbnail}"
                                               Stretch="Uniform" />
                                    </Border>

                                    <StackPanel Grid.Column="2"
                                                Margin="9,0,0,0">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold" />

                                        <TextBlock Text="{Binding CommentPreview}"
                                                   Margin="0,4,0,0"
                                                   MaxHeight="38"
                                                   Foreground="#C8CAD1"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Text="{Binding PositionText}"
                                                   Margin="0,5,0,0"
                                                   Foreground="#83B8FA"
                                                   FontSize="11" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          Background="#30323C" />

            <!-- Related image and clickable annotation overlays -->
            <Border Grid.Column="2"
                    Background="#0F1016"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <Grid x:Name="PreviewHost"
                      ClipToBounds="True"
                      SizeChanged="PreviewHost_SizeChanged">
                    <Image x:Name="RelatedImage"
                           Stretch="Uniform" />

                    <Canvas x:Name="AnnotationOverlay"
                            Background="Transparent" />

                    <TextBlock x:Name="MissingImageTextBlock"
                               Visibility="Collapsed"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#FF8C8C"
                               FontSize="18"
                               TextAlignment="Center"
                               Margin="20" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          Background="#30323C" />

            <!-- Selected annotation details -->
            <Border Grid.Column="4"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource PanelAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12">
                        <TextBlock Text="Selected Annotation"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="95" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Title"
                                           Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock x:Name="TitleTextBlock"
                                           Grid.Row="0"
                                           FontWeight="SemiBold"
                                           Style="{StaticResource DetailValueStyle}"
                                           Grid.Column="1"/>

                                <TextBlock Grid.Row="1"
                                           Text="Comment"
                                           Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock x:Name="CommentTextBlock"
                                           Grid.Row="1"
                                           Style="{StaticResource DetailValueStyle}"
                                           Grid.Column="1"/>

                                <TextBlock Grid.Row="2"
                                           Text="Keywords"
                                           Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock x:Name="KeywordsTextBlock"
                                           Grid.Row="2"
                                           Foreground="#83B8FA"
                                           Style="{StaticResource DetailValueStyle}"
                                           Grid.Column="1"/>

                                <TextBlock Grid.Row="3"
                                           Text="Cross-references"
                                           Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock x:Name="ReferencesTextBlock"
                                           Grid.Row="3"
                                           Style="{StaticResource DetailValueStyle}"
                                           Grid.Column="1"/>

                                <TextBlock Grid.Row="4"
                                           Text="Shape"
                                           Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock x:Name="ShapeTextBlock"
                                           Grid.Row="4"
                                           Style="{StaticResource DetailValueStyle}"
                                           Grid.Column="1"/>

                                <TextBlock Grid.Row="5"
                                           Text="Card"
                                           Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock x:Name="CardNumberTextBlock"
                                           Grid.Row="5"
                                           Style="{StaticResource DetailValueStyle}"
                                           Grid.Column="1"/>

                                <TextBlock Grid.Row="6"
                                           Text="Image"
                                           Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock x:Name="ImagePathTextBlock"
                                           Grid.Row="6"
                                           Style="{StaticResource DetailValueStyle}"
                                           Grid.Column="1"/>

                                <TextBlock Grid.Row="7"
                                           Text="Created"
                                           Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock x:Name="CreatedTextBlock"
                                           Grid.Row="7"
                                           Style="{StaticResource DetailValueStyle}"
                                           Grid.Column="1"/>

                                <TextBlock Grid.Row="8"
                                           Text="Modified"
                                           Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock x:Name="ModifiedTextBlock"
                                           Grid.Row="8"
                                           Style="{StaticResource DetailValueStyle}"
                                           Grid.Column="1"/>

                                <TextBlock Grid.Row="9"
                                           Text="Annotation ID"
                                           Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock x:Name="AnnotationIdTextBlock"
                                           Grid.Row="9"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Style="{StaticResource DetailValueStyle}"
                                           Grid.Column="1"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="2"
                   Margin="10,5"
                   Foreground="{StaticResource MutedBrush}" />
    </Grid>
</Window>