<Window x:Class="SymbolDB.AnnotationsWpf"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SDB8 Annotations"
        Width="1500"
        Height="920"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#171820"
        Foreground="#E8E8EC"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#23242D" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#2B2D38" />
        <SolidColorBrush x:Key="BorderBrush" Color="#3A3D49" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A5A7B2" />
        <SolidColorBrush x:Key="AccentBrush" Color="#4E91E8" />

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#ECECF1" />
            <Setter Property="Background" Value="#343642" />
            <Setter Property="BorderBrush" Value="#4A4D5A" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#F1F1F4" />
            <Setter Property="Background" Value="#30323C" />
            <Setter Property="BorderBrush" Value="#494C59" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="Padding" Value="8,5" />
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E5E6EA" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#E3E4E9" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <!-- Deck and search toolbar -->
        <Border Grid.Row="0"
                Background="#20212A"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8">
            <Grid>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="300" />
        <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <Button Grid.Column="0"
            Content="Open Deck Folder"
            Click="OpenDeck_Click" />

    <TextBox x:Name="DeckFolderTextBox"
             Grid.Column="1"
             Margin="6,3"
             IsReadOnly="True"
             VerticalContentAlignment="Center"
             ToolTip="Every deck has its own folder containing that deck's images." />

    <Button Grid.Column="2"
            Content="Deck Details"
            Click="DeckDetails_Click"
            ToolTip="Update the deck version and description" />

    <TextBox x:Name="SearchTextBox"
             Grid.Column="3"
             Margin="6,3"
             VerticalContentAlignment="Center"
             ToolTip="Search annotation titles, comments, keywords, and cross-references"
             KeyDown="SearchTextBox_KeyDown" />

    <Button Grid.Column="4"
            Content="Search"
            Click="Search_Click" />
</Grid>
        </Border>

        <!-- Annotation tools -->
        <Border Grid.Row="1"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,4">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Selection tool:"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"
                               Margin="4,0,8,0" />

                    <RadioButton x:Name="RectangleTool"
                                 Content="Rectangle"
                                 Tag="Rectangle"
                                 IsChecked="True"
                                 Click="Tool_Click" />

                    <RadioButton Content="Ellipse"
                                 Tag="Ellipse"
                                 Click="Tool_Click" />

                    <RadioButton Content="Highlight"
                                 Tag="Highlight"
                                 Click="Tool_Click" />

                    <RadioButton Content="Freehand"
                                 Tag="Freehand"
                                 Click="Tool_Click" />

                    <Separator Margin="14,3" />

                    <Button Content="Previous"
                            Click="Previous_Click" />

                    <Button Content="Next"
                            Click="Next_Click" />
                    <Button Content="Browse Annotations"
        Click="BrowseAnnotations_Click"
        ToolTip="Display all annotations and their related deck images" />
                    <Button Content="Annotation Display"
        Click="DisplayAnnotations_Click"
        ToolTip="Display spatially ordered annotations for the current deck" />
                    <TextBlock x:Name="ImagePositionTextBlock"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="12,0" />
                </StackPanel>

                <TextBlock x:Name="DeckNameTextBlock"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="8,0" />
            </Grid>
        </Border>

        <!-- Main image and annotation inspector -->
        <Grid Grid.Row="2" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="390" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Padding="10,5">
                    <Grid>
                        <TextBlock x:Name="ImageTitleTextBlock"
                                   FontSize="17"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock x:Name="AnnotationCountTextBlock"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" />
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Background="#101116"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1,0,1,1"
                        Padding="8">
                    <Grid x:Name="AnnotationSurface"
      ClipToBounds="True"
      SizeChanged="AnnotationSurface_SizeChanged">

    <Image x:Name="MainImage"
           Panel.ZIndex="0"
           HorizontalAlignment="Stretch"
           VerticalAlignment="Stretch"
           Stretch="Uniform"
           SnapsToDevicePixels="True" />

    <Canvas x:Name="AnnotationCanvas"
            Panel.ZIndex="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="#01000000"
            Cursor="Cross"
            MouseLeftButtonDown="AnnotationCanvas_MouseLeftButtonDown"
            MouseMove="AnnotationCanvas_MouseMove"
            MouseLeftButtonUp="AnnotationCanvas_MouseLeftButtonUp" />
</Grid>
                </Border>
            </Grid>

            <!-- Annotation panel -->
            <Border Grid.Column="1"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Annotation editor"
                                   Style="{StaticResource SectionTitle}" />

                        <TextBlock Text="Title"
                                   Foreground="{StaticResource MutedBrush}" />

                        <TextBox x:Name="AnnotationTitleTextBox"
                                 Margin="0,4,0,9" />

                        <TextBlock Text="Comment"
                                   Foreground="{StaticResource MutedBrush}" />

                        <TextBox x:Name="AnnotationCommentTextBox"
                                 Height="82"
                                 Margin="0,4,0,9"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />

                        <TextBlock Text="Keywords"
                                   Foreground="{StaticResource MutedBrush}" />

                        <TextBox x:Name="AnnotationKeywordsTextBox"
                                 Margin="0,4,0,9"
                                 ToolTip="Separate keywords with commas" />

                        <TextBlock Text="Cross-references"
                                   Foreground="{StaticResource MutedBrush}" />

                        <TextBox x:Name="AnnotationReferencesTextBox"
                                 Margin="0,4,0,9"
                                 ToolTip="Related symbols, cards, images, or annotation IDs" />

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="SaveAnnotationButton"
                                    Content="Save Annotation"
                                    Click="SaveAnnotation_Click"
                                    IsEnabled="False" />

                            <Button Content="Cancel"
                                    Click="CancelEdit_Click" />

                            <Button Content="Delete"
                                    Click="DeleteAnnotation_Click" />
                        </StackPanel>
                    </StackPanel>

                    <Separator Grid.Row="1"
                               Margin="0,12" />

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Annotations"
                                       Style="{StaticResource SectionTitle}" />

                            <ItemsControl x:Name="AnnotationItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding}"
                                                Click="AnnotationCard_Click"
                                                HorizontalContentAlignment="Stretch"
                                                Padding="9"
                                                Margin="0,0,0,7">
                                            <StackPanel>
                                                <Image Source="{Binding SelectionImage}"
                                       Height="110"
                                       MaxWidth="240"
                                       Margin="0,0,0,7"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Left" />

                                       <TextBlock Text="{Binding Title}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />

                                       <TextBlock Text="{Binding Comment}"
                                           Foreground="#C1C3CA"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           MaxHeight="48" />

                                        <TextBlock Text="{Binding Keywords}"
                                           Foreground="#83B8FA"
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap" />
                                          </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="3"
                            Background="{StaticResource PanelAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            Padding="8"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Search results"
                                       Style="{StaticResource SectionTitle}" />

                            <ListBox x:Name="SearchResultsListBox"
                                     Height="95"
                                     Background="#252731"
                                     Foreground="White"
                                     BorderThickness="0"
                                     DisplayMemberPath="DisplayText"
                                     SelectionChanged="SearchResultsListBox_SelectionChanged" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Background="#20212A"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,5">
            <TextBlock x:Name="StatusTextBlock"
                       Foreground="{StaticResource MutedBrush}"
                       Text="Open a deck folder to begin." />
        </Border>
    </Grid>
</Window>